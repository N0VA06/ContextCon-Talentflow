# ── CrustData ─────────────────────────────────────────────────────────────────
# Get your key from https://app.crustdata.com
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# ── AWS Bedrock (Claude) ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ── Optional overrides ─────────────────────────────────────────────────────────
# Claude inference profile ARN (default: Claude Haiku 4.5 cross-region)
# CLAUDE_INFERENCE_PROFILE=arn:aws:bedrock:us-east-1:149536491531:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0

# LLM settings
# MAX_TOKENS=4096
# TEMPERATURE=0.1
# BEDROCK_TIMEOUT=120

# App settings
# REQUEST_TIMEOUT=30
# DEBUG=false
